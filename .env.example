# Notion OAuth credentials
# Create an OAuth integration at: https://www.notion.so/my-integrations
# Set redirect URI to: http://localhost:3000/api/notion/callback (dev)
#                  or: https://yourdomain.com/api/notion/callback (prod)
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:3000/api/notion/callback

# Cookie encryption secret — any random 32+ char string
SESSION_SECRET=your-random-secret-here

# AI Provider keys (user provides these in the Settings UI — not required server-side)
# Kept here for CLI usage only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
