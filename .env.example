# Notion OAuth credentials
# Create an OAuth integration at: https://www.notion.so/my-integrations
# Set redirect URI to: http://localhost:3000/api/notion/callback (dev)
#                  or: https://yourdomain.com/api/notion/callback (prod)
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:3000/api/notion/callback

# AI provider keys are NOT needed here — users provide their own via the Settings UI (BYOK).
# Keys are sent per-request in the x-ai-key header and never stored server-side.
